+static void WriteCheckpointStatus(const char* action)
+{
+	const std::string path =
+		"/tmp/pf-exiai-checkpoint-" + std::to_string(getpid()) + ".status";
+	const std::string temporary_path = path + ".tmp";
+	if (FILE* status = fopen(temporary_path.c_str(), "w"))
+	{
+		fprintf(status, "%s %u\n", action, ++s_checkpoint_generation);
+		fclose(status);
+		rename(temporary_path.c_str(), path.c_str());
+	}
+}
+
+enum class CheckpointRequest
+{
+	None,
+	Save,
+	Load,
+};
+
+static CheckpointRequest PollCheckpointRequest()
+{
+	const std::string path =
+		"/tmp/pf-exiai-checkpoint-" + std::to_string(getpid()) + ".request";
+	char action[16] = {};
+	if (FILE* request = fopen(path.c_str(), "r"))
+	{
+		const int fields = fscanf(request, "%15s", action);
+		fclose(request);
+		unlink(path.c_str());
+		if (fields == 1 && strcmp(action, "save") == 0)
+			return CheckpointRequest::Save;
+		else if (fields == 1 && strcmp(action, "load") == 0)
+			return CheckpointRequest::Load;
+	}
+	return CheckpointRequest::None;
+}
+
+static void DispatchCheckpointRequests()
+{
+	const CheckpointRequest request = PollCheckpointRequest();
+	if (request == CheckpointRequest::Save)
+	{
+		s_checkpoint = std::make_unique<SlippiSavestate>();
+		s_checkpoint->Capture();
+		WriteCheckpointStatus("saved");
+	}
+	if (request == CheckpointRequest::Load)
+	{
+		if (s_checkpoint)
+		{
+			s_checkpoint->Load({
+				{0x804BF9D2, 4},
+				{0x804C3DE4, 20},
+				{0x804C4560, 44},
+				{0x804D7760, 36},
+			});
+			// Rebase the checkpoint onto the restored game state plus the
+			// deliberately preserved monotonic Slippi/interrupt state. This
+			// mirrors the short-lived rollback window used by ExiAI instead of
+			// replaying one increasingly stale host/game boundary indefinitely.
+			s_checkpoint = std::make_unique<SlippiSavestate>();
+			s_checkpoint->Capture();
+			WriteCheckpointStatus("loaded");
+		}
+		else
+		{
+			WriteCheckpointStatus("empty");
+		}
+	}
+}
+
